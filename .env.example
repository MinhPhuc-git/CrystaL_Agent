# Thư mục dữ liệu; đường dẫn tương đối tính từ thư mục CrystaL.
CRYSTAL_DATA_DIR=data
CRYSTAL_DB_ENABLED=false
# Các đường dẫn bên dưới tính từ CRYSTAL_DATA_DIR; cũng có thể dùng đường dẫn tuyệt đối.
CRYSTAL_DB_PATH=db/crystal.sqlite3
CRYSTAL_RAW_LOG_PATH=raw/security-events.jsonl
CRYSTAL_NORMALIZED_LOG_DIR=logs
# Số lần đăng nhập thất bại và khoảng thời gian để báo brute force, tính bằng giây.
CRYSTAL_BRUTEFORCE_THRESHOLD=5
CRYSTAL_BRUTEFORCE_WINDOW_SECONDS=300
